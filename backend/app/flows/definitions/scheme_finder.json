{
  "id": "scheme_finder",
  "version": 2,
  "title": {
    "en": "Find government schemes",
    "hi": "सरकारी योजनाएँ खोजें"
  },
  "description": {
    "en": "Find schemes that match your age, gender, state and income.",
    "hi": "आपकी उम्र, लिंग, राज्य और आमदनी के हिसाब से योजनाएँ खोजें।"
  },
  "site": "https://www.myscheme.gov.in",
  "mock_path": "/myscheme",
  "est_minutes_saved": 15,
  "keywords": [
    "scheme",
    "schemes",
    "yojana",
    "yojna",
    "योजना",
    "योजनाएँ",
    "योजनाएं",
    "pension",
    "पेंशन",
    "benefit",
    "sarkari",
    "सरकारी",
    "subsidy",
    "myscheme"
  ],
  "examples": [
    "Which government schemes can I get?",
    "मेरे लिए कौन सी सरकारी योजना है?",
    "Mujhe pension yojana batao, meri umar 65 hai",
    "Schemes for a 30 year old woman in Bihar"
