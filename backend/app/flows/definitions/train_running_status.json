{
  "id": "train_running_status",
  "version": 2,
  "title": {
    "en": "Where is my train?",
    "hi": "मेरी ट्रेन कहाँ है?"
  },
  "description": {
    "en": "Live running status of a train: last station, delay and expected arrival.",
    "hi": "ट्रेन की लाइव स्थिति: आखिरी स्टेशन, देरी और पहुँचने का समय।"
  },
  "site": "https://enquiry.indianrail.gov.in/mntes",
  "mock_path": "/mntes",
  "est_minutes_saved": 5,
  "keywords": [
    "train",
    "ट्रेन",
    "gaadi",
    "gadi",
    "गाड़ी",
    "running",
    "status",
    "late",
    "delay",
    "लेट",
    "कहाँ",
    "kahan",
    "kaha",
    "where",
    "ntes",
    "rail",
    "रेल"
  ],
  "examples": [
    "Where is train 12301?",
    "मेरी ट्रेन 12951 कहाँ है?",
    "12002 kitni late hai",
    "train running status 12627 yesterday"
  ],
  "params": [
    {
      "name": "train_no",
      "type": "string",
      "regex": "^\\d{5}$",
      "prompt": {
        "en": "What is the 5-digit train number?",
        "hi": "ट्रेन का 5 अंकों का नंबर क्या है?"
      },
      "example": "12301"
    },
    {
      "name": "date",
      "type": "date",
      "required": false,
      "default": "today",
      "prompt": {
        "en": "Which day did the train start? Today or yesterday?",
        "hi": "ट्रेन किस दिन चली थी? आज या कल?"
      },
      "example": "today"
    }
  ],
  "steps": [
    {
      "type": "narrate",
      "en": "Opening the train enquiry website.",
      "hi": "रेल पूछताछ वेबसाइट खोल रहे हैं।"
    },
    {
      "type": "goto",
      "url": "{{base}}/",
      "timeout_ms": 45000
    },
    {
      "type": "narrate",
      "en": "Entering train number {{train_no}}.",
      "hi": "ट्रेन नंबर {{train_no}} डाल रहे हैं।"
    },
    {
      "type": "fill",
      "locator": {
        "role": "textbox",
        "name": "Train No./Name"
      },
      "value": "{{train_no}}",
      "typing_delay_ms": 120
    },
    {
      "type": "wait_for",
      "locator": {
        "css": "h3:has-text('{{train_no}}'), h4:has-text('Invalid Train No')"
      },
      "timeout_ms": 25000
    },
    {
      "type": "if_exists",
      "locator": {
        "text": "Invalid Train No."
      },
      "timeout_ms": 0,
      "then": [
        {
          "type": "fail",
          "message": {
            "en": "I could not find train {{train_no}}. Please check the number.",
            "hi": "ट्रेन {{train_no}} नहीं मिली। कृपया नंबर जाँच लें।"
          }
        }
      ]
    },
    {
      "type": "if_exists",
      "locator": {
        "role": "tab",
        "name": "{{date|date:%d-%b-%Y}}",
        "exact": true
      },
      "timeout_ms": 3000,
      "then": [
        {
          "type": "click",
          "locator": {
            "role": "tab",
            "name": "{{date|date:%d-%b-%Y}}",
            "exact": true
          }
        }
      ],
      "else": [
        {
          "type": "fail",
          "message": {
            "en": "I can only check trains that started in the last few days.",
            "hi": "मैं सिर्फ़ पिछले कुछ दिनों में चली ट्रेनों की स्थिति देख सकता हूँ।"
          }
        }
      ]
    },
    {
      "type": "pause",
      "ms": 800
    },
    {
      "type": "narrate",
      "en": "Reading the train's status.",
      "hi": "ट्रेन की स्थिति पढ़ रहे हैं।"
    },
    {
      "type": "wait_for",
      "locator": {
        "css": "[role=tabpanel].active h6"
      },
      "timeout_ms": 20000
    },
    {
      "type": "extract",
      "locator": {
        "css": "h3:has-text('{{train_no}}')"
      },
      "into": "train_name"
    },
    {
      "type": "extract",
      "locator": {
        "css": "[role=tabpanel].active h6"
      },
      "into": "status"
    },
    {
      "type": "extract",
      "locator": {
        "css": "[role=tabpanel].active h4"
      },
      "into": "start"
    },
    {
      "type": "screenshot"
    }
  ],
  "result_template": {
    "en": "{{train_name}}: {{status}}.",
    "hi": "ट्रेन {{train_name}}: {{status}}।"
  },
  "confirm_template": {
    "en": "You want to know where train {{train_no}} is (started {{date}})?",
    "hi": "आप ट्रेन {{train_no}} की स्थिति जानना चाहते हैं ({{date}} चली)?"
  },
  "requires": [],
  "verified_at": "2026-10-24T10:33:17+00:00",
  "enabled": true,
  "notes": "Live selectors recorded on 2026-10-24 against https://enquiry.indianrail.gov.in/mntes/ (Spot Your Train). The train box reacts to key presses, so the number is typed key by key. Start dates appear as tabs named like 23-Oct-2026; the status sentence is the h6 in the active tab panel."
}
