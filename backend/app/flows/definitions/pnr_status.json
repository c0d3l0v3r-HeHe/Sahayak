{
  "id": "pnr_status",
  "version": 2,
  "title": {
    "en": "PNR status",
    "hi": "PNR स्थिति"
  },
  "description": {
    "en": "Check if your train ticket is confirmed.",
    "hi": "देखिए कि आपका ट्रेन टिकट कन्फ़र्म हुआ या नहीं।"
  },
  "site": "https://www.indianrail.gov.in/enquiry",
  "mock_path": "/pnr",
  "est_minutes_saved": 4,
  "keywords": [
    "pnr",
    "पीएनआर",
    "ticket",
    "टिकट",
    "confirm",
    "confirmed",
    "कन्फर्म",
    "कन्फ़र्म",
    "waiting",
    "वेटिंग",
    "rac",
    "seat",
    "berth",
    "सीट"
  ],
  "examples": [
    "Check my PNR 1234567890",
    "मेरा टिकट कन्फर्म हुआ क्या?",
    "PNR status batao 4512345678",
    "is my ticket confirmed"
  ],
  "params": [
    {
      "name": "pnr",
      "type": "string",
      "regex": "^\\d{10}$",
      "sensitive": true,
      "prompt": {
        "en": "Please tell me the 10-digit PNR number from your ticket.",
        "hi": "कृपया टिकट पर लिखा 10 अंकों का PNR नंबर बताइए।"
      },
      "example": "4512345678"
    }
  ],
  "steps": [
    {
      "type": "narrate",
      "en": "Opening the PNR enquiry page.",
      "hi": "PNR पूछताछ पेज खोल रहे हैं।"
    },
    {
      "type": "goto",
      "url": "{{base}}/PNR/PnrEnquiry.html?locale=en",
      "timeout_ms": 45000
    },
    {
      "type": "narrate",
      "en": "Entering your PNR number.",
      "hi": "आपका PNR नंबर डाल रहे हैं।"
    },
    {
      "type": "fill",
      "locator": {
        "role": "textbox",
        "name": "Enter PNR No."
      },
      "value": "{{pnr}}",
      "typing_delay_ms": 80
    },
    {
      "type": "click",
      "locator": {
        "css": "#modal1"
      }
    },
    {
      "type": "wait_for",
      "locator": {
        "css": "#CaptchaImgID"
      },
      "timeout_ms": 20000
    },
    {
      "type": "pause",
      "ms": 500
    },
    {
      "type": "narrate",
      "en": "The website wants to check that a person is using it. I need your help.",
      "hi": "वेबसाइट देखना चाहती है कि इसे कोई इंसान चला रहा है। मुझे आपकी मदद चाहिए।"
    },
    {
      "type": "ask_user",
      "kind": "captcha",
      "prompt": {
        "en": "Please read what is written in the picture.",
        "hi": "कृपया तस्वीर में जो लिखा है, वह पढ़कर बताइए।"
      },
      "screenshot_locator": {
        "css": "#CaptchaImgID"
      },
      "fill_locator": {
        "css": "#inputCaptcha"
      }
    },
    {
      "type": "click",
      "locator": {
        "css": "#submitPnrNo"
      }
    },
    {
      "type": "wait_for",
      "locator": {
        "css": "table:has(th:has-text('Booking Status')) td, #errorMessagediv:visible"
      },
      "timeout_ms": 30000
    },
    {
      "type": "if_exists",
      "locator": {
        "css": "#errorMessagediv:has-text('aptcha')",
        "visible": true
      },
      "timeout_ms": 0,
      "then": [
        {
          "type": "narrate",
          "en": "That did not match. Let's try once more.",
          "hi": "यह मेल नहीं खाया। एक बार फिर कोशिश करते हैं।"
        },
        {
          "type": "click",
          "locator": {
            "css": "#modal1"
          }
        },
        {
          "type": "wait_for",
          "locator": {
            "css": "#CaptchaImgID"
          },
          "timeout_ms": 20000
        },
        {
          "type": "pause",
          "ms": 500
        },
        {
          "type": "ask_user",
          "kind": "captcha",
          "prompt": {
            "en": "Please read what is written in the picture.",
            "hi": "कृपया तस्वीर में जो लिखा है, वह पढ़कर बताइए।"
          },
          "screenshot_locator": {
            "css": "#CaptchaImgID"
          },
          "fill_locator": {
            "css": "#inputCaptcha"
          }
        },
        {
          "type": "click",
          "locator": {
            "css": "#submitPnrNo"
          }
        },
        {
          "type": "wait_for",
          "locator": {
            "css": "table:has(th:has-text('Booking Status')) td, #errorMessagediv:visible"
          },
          "timeout_ms": 30000
        },
        {
          "type": "if_exists",
          "locator": {
            "css": "#errorMessagediv:has-text('aptcha')",
            "visible": true
          },
          "timeout_ms": 0,
          "then": [
            {
              "type": "fail",
              "message": {
                "en": "It did not match again. Please try later.",
                "hi": "यह फिर से मेल नहीं खाया। कृपया बाद में कोशिश करें।"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "if_exists",
      "locator": {
        "css": "#errorMessagediv",
        "visible": true
      },
      "timeout_ms": 0,
      "then": [
        {
          "type": "fail",
          "message": {
            "en": "The website could not find this PNR. Please check the number on your ticket.",
            "hi": "वेबसाइट को यह PNR नहीं मिला। कृपया टिकट पर लिखा नंबर जाँच लें।"
          }
        }
      ]
    },
    {
      "type": "narrate",
      "en": "Reading your ticket status.",
      "hi": "आपके टिकट की स्थिति पढ़ रहे हैं।"
    },
    {
      "type": "extract",
      "as": "table",
      "locator": {
        "css": "table:has(th:text-is('Train Number'))"
      },
      "into": "journey",
      "columns": [
        "train_number",
        "train_name",
        "boarding_date",
        "from",
        "to",
        "reserved_upto",
        "boarding_point",
        "class"
      ]
    },
    {
      "type": "extract",
      "as": "table",
      "locator": {
        "css": "table:has(th:has-text('Booking Status'))"
      },
      "into": "passengers",
      "columns": [
        "passenger",
        "booking_status",
        "current_status"
      ]
    },
    {
      "type": "extract",
      "as": "table",
      "locator": {
        "css": "table:has(th:text-is('Charting Status'))"
      },
      "into": "fare",
      "columns": [
        "total_fare",
        "charting_status",
        "remarks",
        "train_status"
      ]
    },
    {
      "type": "screenshot"
    }
  ],
  "result_template": {
    "en": "{{#journey}}Train {{train_number}} {{train_name}}, {{boarding_date}}. {{/journey}}{{#passengers}}Passenger {{@n}}: {{current_status}}. {{/passengers}}{{#fare}}{{charting_status}}.{{/fare}}",
    "hi": "{{#journey}}ट्रेन {{train_number}} {{train_name}}, {{boarding_date}}। {{/journey}}{{#passengers}}यात्री {{@n}}: {{current_status}}। {{/passengers}}{{#fare}}{{charting_status}}।{{/fare}}"
  },
  "confirm_template": {
    "en": "You want to check the status of PNR {{pnr}}?",
    "hi": "आप PNR {{pnr}} की स्थिति जानना चाहते हैं?"
  },
  "requires": [
    "captcha"
  ],
  "verified_at": null,
  "enabled": true,
  "notes": "TODO(verify): https://www.indianrail.gov.in/enquiry/PNR/PnrEnquiry.html was recorded on 2026-10-24 up to the PNR box (#inputPnrNo, 'Enter PNR No.') and the Submit button (#modal1), and the result tables were seen. The site then returned 502s, so the CAPTCHA modal selectors (#CaptchaImgID, #inputCaptcha, #submitPnrNo) and the error box (#errorMessagediv) are not yet verified. Re-run scripts/record_flow.py verify pnr_status --live. The CAPTCHA is always handed to the user."
}
