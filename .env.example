# Copy to .env and adjust. Every value is optional; defaults work for local dev.
APP_ENV=dev
LOG_LEVEL=INFO

# MongoDB (docker-compose overrides this to mongodb://mongo:27017)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=sahayak

# CHANGE THIS in any shared deployment: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-32-bytes
JWT_TTL_DAYS=30

# true = all flows run against the bundled mock sites (stage-safe, no internet needed)
DEMO_MODE=true
MOCK_SITES_URL=http://localhost:8000/mock

# Intent parsing. Leave all keys empty to use the offline `rules` parser.
# INTENT_PROVIDER forces a provider: gemini | groq | ollama | rules
INTENT_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Browser engine: playwright (default) | tinyfish (only if TINYFISH_API_KEY is set)
BROWSER_ENGINE=playwright
TINYFISH_API_KEY=
HEADLESS=true

# Worker
WORKER_CONCURRENCY=2
PER_SITE_CONCURRENCY=2
ACTION_DELAY_MIN_MS=250
ACTION_DELAY_MAX_MS=700
JOB_CLAIM_TIMEOUT_S=300
JOB_MAX_ATTEMPTS=2
HANDOFF_TIMEOUT_S=300

# Data retention
TASK_TTL_DAYS=7
HANDOFF_TTL_MINUTES=10

CORS_ORIGINS=*
